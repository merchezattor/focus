# ============================================
# Focus — Docker Compose environment
# ============================================
# Copy to `.env` (compose loads it automatically) and fill in the values.
#   cp .env.docker.example .env
# DO NOT commit your real .env file.

# ============================================
# PostgreSQL (db service)
# ============================================
POSTGRES_USER=focus
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=focus
# Host port to expose Postgres on (container port is always 5432).
POSTGRES_PORT=5432

# ============================================
# App (app service)
# ============================================
# Host port to serve the app on.
APP_PORT=3000

# Secret for session encryption — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl

# Public base URL of the deployment (no trailing slash).
# For homelab access, set these to the host/IP you reach the app on,
# e.g. http://192.168.1.50:3000 or https://focus.your-domain.lan
BETTER_AUTH_BASE_URL=http://localhost:3000
# NOTE: baked in at BUILD time — rebuild the image after changing it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Google OAuth (optional — leave blank to disable social login)
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
