# ============================================
# Focus — Docker Compose environment
# ============================================
# Copy to `.env` (compose loads it automatically) and fill in the values.
#   cp .env.docker.example .env && chmod 600 .env
# DO NOT commit your real .env file.

# ============================================
# PostgreSQL (db service)
# ============================================
POSTGRES_USER=focus
POSTGRES_DB=focus

# IMPORTANT — must be URL-safe. This value is interpolated verbatim into
# DATABASE_URL, so `@ / : # ?` silently corrupt the connection string.
# Generate one with: openssl rand -hex 32
#
# Read only on the FIRST boot, when the pgdata volume is initialized. Changing
# it later does not change the database's password — you would also have to
# ALTER USER inside the running container (or destroy the volume, losing data).
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32

# The db port is deliberately not published. For a host-side shell:
#   docker compose exec db psql -U focus focus

# ============================================
# App (web service)
# ============================================
# Host port the app is served on.
APP_PORT=3077

# Interface to bind that port to. Keep this on loopback and reach the app
# through a reverse proxy (e.g. Tailscale Serve). Setting 0.0.0.0 exposes the
# app to every network the host is attached to.
APP_BIND=127.0.0.1

# Secret for session encryption — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl

# Public base URL of the deployment (no trailing slash). The SPA and API share
# this single origin (Caddy), so the session cookie is first-party.
# An https:// value automatically makes the auth cookie Secure, so this must
# match how you actually reach the app, e.g.
#   https://focus.example.ts.net   (behind a TLS-terminating proxy)
#   http://192.168.1.50:3077       (plain LAN, no Secure cookie)
BETTER_AUTH_BASE_URL=http://localhost:3077

# No VITE_* build arg is needed: the SPA calls the API on relative paths and
# better-auth defaults to the current origin, because both are served by Caddy.

# ============================================
# Google OAuth (optional — leave blank to disable social login)
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
