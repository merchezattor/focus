{
	"name": "focus",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"dev": "pnpm --parallel --filter @focus/api --filter @focus/web dev",
		"dev:api": "pnpm --filter @focus/api dev",
		"dev:web": "pnpm --filter @focus/web dev",
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r --workspace-concurrency=1 test",
		"lint": "biome check",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"db:generate": "pnpm --filter @focus/core db:generate",
		"db:migrate": "pnpm --filter @focus/core db:migrate",
		"db:push": "pnpm --filter @focus/core db:push",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"pnpm": {
		"overrides": {
			"@playwright/test": "^1.58.2",
			"@hono/node-server": "2.0.6",
			"@modelcontextprotocol/sdk": "1.27.0",
			"better-auth": "1.4.19",
			"dotenv": "17.3.1",
			"drizzle-orm": "0.45.1",
			"hono": "4.12.27",
			"postgres": "3.4.8",
			"uuid": "13.0.0",
			"zod": "4.3.6"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@playwright/test": "^1.58.2"
	}
}
