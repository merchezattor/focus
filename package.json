{
	"name": "focus",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"prepare": "lefthook install || true",
		"dev": "pnpm --parallel --filter @focus/api --filter @focus/web dev",
		"dev:api": "pnpm --filter @focus/api dev",
		"dev:web": "pnpm --filter @focus/web dev",
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r --workspace-concurrency=1 test",
		"lint": "biome check",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"db:generate": "pnpm --filter @focus/core db:generate",
		"db:migrate": "pnpm --filter @focus/core db:migrate",
		"db:push": "pnpm --filter @focus/core db:push",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"pnpm": {
		"overrides": {
			"@playwright/test": "^1.58.2"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@playwright/test": "^1.58.2",
		"lefthook": "^2.2.2"
	}
}
